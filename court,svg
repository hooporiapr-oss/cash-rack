<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 900 640" width="900" height="640" role="img" aria-label="Cash Rack court diagram: four three-point spots and one foul line spot" xmlns:c2pa="http://c2pa.org/manifest"><metadata><c2pa:manifest></c2pa:manifest></metadata>

  <defs>
    <!-- The floor, warm and dark so the gold markers carry. -->
    <linearGradient id="floor" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#3A1C0B"/>
      <stop offset="100%" stop-color="#2B1810"/>
    </linearGradient>

    <radialGradient id="spotFill" cx="38%" cy="34%">
      <stop offset="0%" stop-color="#FFE9A8"/>
      <stop offset="55%" stop-color="#E8B23A"/>
      <stop offset="100%" stop-color="#B9812A"/>
    </radialGradient>

    <radialGradient id="foulFill" cx="38%" cy="34%">
      <stop offset="0%" stop-color="#FFD0A6"/>
      <stop offset="55%" stop-color="#C9601F"/>
      <stop offset="100%" stop-color="#8E3F11"/>
    </radialGradient>

    <filter id="glow" x="-60%" y="-60%" width="220%" height="220%">
      <feGaussianBlur stdDeviation="9" result="b"/>
      <feMerge><feMergeNode in="b"/><feMergeNode in="SourceGraphic"/></feMerge>
    </filter>
  </defs>

  <rect width="900" height="640" fill="#160E1C"/>

  <!-- ══ the half court ══
       Drawn to real proportions: a 50ft wide floor, the key 16ft
       across and 19ft deep, the arc 23ft 9in at the top. At this
       scale 1 foot is 16 pixels. -->
  <g transform="translate(50,40)">

    <rect x="0" y="0" width="800" height="560" rx="10" fill="url(#floor)" stroke="rgba(255,178,116,.35)" stroke-width="3"/>

    <!-- baseline, heavier than the rest -->
    <line x1="0" y1="557" x2="800" y2="557" stroke="rgba(255,178,116,.6)" stroke-width="6"/>

    <!-- the key: 16ft wide, 19ft deep, off the baseline -->
    <rect x="272" y="253" width="256" height="304" fill="rgba(232,178,58,.05)" stroke="rgba(255,178,116,.4)" stroke-width="3"/>

    <!-- free-throw circle, 6ft radius on the line -->
    <circle cx="400" cy="253" r="96" fill="none" stroke="rgba(255,178,116,.4)" stroke-width="3"/>
    <line x1="272" y1="253" x2="528" y2="253" stroke="rgba(255,178,116,.55)" stroke-width="4"/>

    <!-- the three-point line: straight from the baseline out to the
         break, then the arc over the top -->
    <path d="M 66 557 L 66 421 A 334 334 0 0 0 734 421 L 734 557"
          fill="none" stroke="rgba(255,178,116,.45)" stroke-width="3"/>

    <!-- hoop and backboard -->
    <line x1="352" y1="533" x2="448" y2="533" stroke="rgba(255,178,116,.5)" stroke-width="5"/>
    <circle cx="400" cy="513" r="12" fill="none" stroke="rgba(255,178,116,.6)" stroke-width="3"/>

    <!-- restricted arc, for the look of a real floor -->
    <path d="M 336 513 A 64 64 0 0 0 464 513" fill="none" stroke="rgba(255,178,116,.22)" stroke-width="2"/>

    <!-- ══ the five stations ══
         Four outside the arc — both corners and both wings-to-top —
         and one on the free-throw line. Spread so the shooter has to
         genuinely move between them. -->

    <!-- 1 · left corner -->
    <g filter="url(#glow)">
      <circle cx="40" cy="500" r="30" fill="url(#spotFill)"/>
    </g>
    <circle cx="40" cy="500" r="30" fill="none" stroke="#FFF0C4" stroke-width="2.5"/>
    <text x="40" y="509" text-anchor="middle" font-family="Archivo, Arial, sans-serif" font-size="27" font-weight="800" fill="#2A1A00">1</text>

    <!-- 2 · left wing -->
    <g filter="url(#glow)">
      <circle cx="128" cy="270" r="30" fill="url(#spotFill)"/>
    </g>
    <circle cx="128" cy="270" r="30" fill="none" stroke="#FFF0C4" stroke-width="2.5"/>
    <text x="128" y="279" text-anchor="middle" font-family="Archivo, Arial, sans-serif" font-size="27" font-weight="800" fill="#2A1A00">2</text>

    <!-- 3 · top of the key -->
    <g filter="url(#glow)">
      <circle cx="400" cy="120" r="30" fill="url(#spotFill)"/>
    </g>
    <circle cx="400" cy="120" r="30" fill="none" stroke="#FFF0C4" stroke-width="2.5"/>
    <text x="400" y="129" text-anchor="middle" font-family="Archivo, Arial, sans-serif" font-size="27" font-weight="800" fill="#2A1A00">3</text>

    <!-- 4 · right wing -->
    <g filter="url(#glow)">
      <circle cx="672" cy="270" r="30" fill="url(#spotFill)"/>
    </g>
    <circle cx="672" cy="270" r="30" fill="none" stroke="#FFF0C4" stroke-width="2.5"/>
    <text x="672" y="279" text-anchor="middle" font-family="Archivo, Arial, sans-serif" font-size="27" font-weight="800" fill="#2A1A00">4</text>

    <!-- 5 · the foul line, in its own colour because it scores
         differently from the other four -->
    <g filter="url(#glow)">
      <circle cx="400" cy="253" r="30" fill="url(#foulFill)"/>
    </g>
    <circle cx="400" cy="253" r="30" fill="none" stroke="#FFD9B8" stroke-width="2.5"/>
    <text x="400" y="262" text-anchor="middle" font-family="Archivo, Arial, sans-serif" font-size="27" font-weight="800" fill="#2A1000">5</text>

  </g>

  <!-- ══ the key to the diagram ══ -->
  <g font-family="Archivo, Arial, sans-serif">
    <circle cx="612" cy="608" r="9" fill="url(#spotFill)"/>
    <text x="630" y="614" font-size="17" font-weight="600" fill="#B7A8C2">Three-point spot · 3 shots each</text>

    <circle cx="70" cy="608" r="9" fill="url(#foulFill)"/>
    <text x="88" y="614" font-size="17" font-weight="600" fill="#B7A8C2">Foul line · 3 shots</text>
  </g>

</svg>
